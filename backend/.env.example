DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgres://jutant:jutant@db:5432/jutant
JUTANT_PACK_PATH=packs/banking
JUTANT_CALLER_SECRET=change-me
JUTANT_SESSION_SECRET=change-me-too
JUTANT_SESSION_TTL_MIN=480
JUTANT_CORS_ORIGINS=http://localhost:5173
JUTANT_LLM_PROVIDER=ollama
JUTANT_LLM_MODEL=qwen2.5:7b
JUTANT_LLM_BASE_URL=http://ollama:11434
JUTANT_LLM_NUM_CTX=8192
JUTANT_EMBED_MODEL=nomic-embed-text
JUTANT_EMBED_DIM=768
JUTANT_MAX_STEPS=4
JUTANT_HISTORY_LIMIT=6
JUTANT_MAX_CONCURRENT_GENERATIONS=2
JUTANT_MCP_DOCUMENTS_URL=http://mcp-documents:8101/mcp
JUTANT_MCP_TRANSACTIONS_URL=http://mcp-transactions:8102/mcp
JUTANT_MCP_SERVICES_URL=http://mcp-services:8103/mcp
JUTANT_BANKING_ADAPTERS=fake
# For JUTANT_BANKING_ADAPTERS=real. Each system also takes _AUTH (none, bearer, basic,
# api_key), _TOKEN, _USERNAME, _PASSWORD, _API_KEY_HEADER, _TIMEOUT_S, _CA_BUNDLE,
# _CLIENT_CERT and _CLIENT_KEY. The mock bank (compose profile mock-bank) answers on both.
# JUTANT_CORE_BANKING_URL=http://mock-bank:8190
# JUTANT_SERVICE_CATALOG_URL=http://mock-bank:8190
# Optional, with their defaults:
# JUTANT_ROUTE_MIN_SIMILARITY=0.80      # routing by meaning decides above this...
# JUTANT_ROUTE_MIN_MARGIN=0.05          # ...and this far ahead of the next feature
# JUTANT_LOGIN_MAX_FAILURES=5           # sign-in lock per username...
# JUTANT_LOGIN_MAX_FAILURES_PER_IP=20   # ...and per address, within
# JUTANT_LOGIN_WINDOW_MIN=15            # this many minutes
# JUTANT_TRUSTED_PROXIES=               # proxies whose X-Forwarded-For is believed
# JUTANT_UPLOAD_RETENTION_DAYS=30
