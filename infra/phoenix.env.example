# Settings for the Phoenix tracing service (compose profile "observability").
# Copy to infra/phoenix.env and replace every value. Keep it out of version control.

# Signs Phoenix's sign-in tokens: at least 32 characters, letters and digits.
PHOENIX_SECRET=change-me-to-32-or-more-letters-and-digits-0001
# Lets the platform send traces: put the same value in backend/.env as JUTANT_TRACING_API_KEY.
# Or create a system API key in Phoenix (Settings) and use that there instead.
PHOENIX_ADMIN_SECRET=change-me-to-32-or-more-letters-and-digits-0002
# The first password of admin@localhost; read only when Phoenix first starts.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=change-me
